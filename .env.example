# PokerCoachAI Environment Configuration — EXAMPLE
# Copy to .env and fill in your values

# M1 Mode: skip DB/Redis, use in-memory Solver + AI
FAKE_MODE=true

# DeepSeek AI (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=medium
DEEPSEEK_THINKING=enabled

# Legacy OpenAI (not used by default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Database (only needed when FAKE_MODE=false)
DATABASE_URL=postgresql+asyncpg://poker:poker_dev@localhost:5432/pokercoachai

# Redis (only needed when FAKE_MODE=false)
REDIS_URL=redis://localhost:6379/0

# Solver
SOLVER_PROVIDER=texas
SOLVER_TIMEOUT_SECONDS=10
